# Export TURNWIRE_HARNESS_DEEPSEEK_API_KEY in the terminal running `npm run dev:dsh`.
# config/dsh-deepseek.patch.yml references its name; do not put the key here.
# The managed host reads dsh.env.json in the XDG Turnwire config directory (0600), the whole DSH
# environment: every string value in it is forwarded to DSH and nothing of it reaches a client.
# A second provider route in the patch file names its credential there too, e.g.
# TURNWIRE_HARNESS_GATEWAY_KEY.
# DSH reads the model key. The Turnwire daemon connects using the launch token below.
# Run the DSH Host separately and copy its launch URL (including ?token=...).
TURNWIRE_DSH_URL=http://127.0.0.1:3080
# TURNWIRE_DSH_TOKEN=
# Independent overrides; defaults follow XDG config/state/data/cache directories.
# TURNWIRE_STATE_HOME=/absolute/path/to/turnwire-state
# TURNWIRE_CONFIG_HOME=/absolute/path/to/turnwire-config
# TURNWIRE_DATA_HOME=/absolute/path/to/turnwire-data
# TURNWIRE_CACHE_HOME=/absolute/path/to/turnwire-cache
# TURNWIRE_PORT=9898
# TURNWIRE_RELAY_URL=wss://relay.example.com
# TURNWIRE_RELAY_TOKEN=generate-a-random-secret-with-openssl-rand-hex-32
# TURNWIRE_REMOTE_URL=https://remote.example.com
# Relay process only: optionally serve the built phone page on the Relay port.
# TURNWIRE_REMOTE_WEB_ROOT=/absolute/path/to/turnwire/apps/remote-web/dist
# Optional existing cloudflared executable; otherwise Turnwire installs its own copy.
# TURNWIRE_CLOUDFLARED_PATH=/opt/homebrew/bin/cloudflared
# Prefer the native Remote Control settings or `turnwire remote` for mode selection.
# Saved settings override the Relay environment defaults above.

# Explicit offline demo, never performs real coding or shell execution:
# TURNWIRE_RUNTIME=demo
