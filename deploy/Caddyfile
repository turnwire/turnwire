{$TURNWIRE_DOMAIN} {
    encode zstd gzip
    header {
        X-Content-Type-Options nosniff
        Referrer-Policy no-referrer
        Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src 'self' wss:; object-src 'none'; base-uri 'none'; frame-ancestors 'none'"
    }
    handle /relay {
        reverse_proxy relay:9899
    }
    handle {
        root * /srv
        file_server
    }
}
